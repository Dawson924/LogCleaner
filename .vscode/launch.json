{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build & Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/LogCleaner.exe",
            "args": [],
            "cwd": "${workspaceFolder}/build",
            "preLaunchTask": "CMake: Build",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}